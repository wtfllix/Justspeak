# Generate independent random values; never put this file under apps/desktop.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
POC_JOIN_CODE=
# Local loopback default. For two machines use trusted WSS/HTTPS domains.
LIVEKIT_URL=ws://127.0.0.1:7880
USE_EXTERNAL_IP=false
# Multi-interface LAN host: set to the server IP reachable by both test computers.
# With USE_EXTERNAL_IP=true, LiveKit's public-IP discovery takes precedence.
LIVEKIT_NODE_IP=
# Optional NIC name from `ip -brief address`, to exclude Docker bridges/VPNs.
LIVEKIT_INTERFACE=
# Optional TLS profile: two DNS records pointing to the Linux host.
API_DOMAIN=api.example.com
MEDIA_DOMAIN=voice.example.com
ACME_EMAIL=admin@example.com
